# Copy to .env.local. Everything but OPENFURQAN_DATA_KEY is optional.
# Keep production secrets in Vercel's environment settings.

# Distributed API rate limiting: Vercel KV REST endpoint and token (set both).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative Upstash names, used only when the KV names above are absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Maintainers only: the data key. Set it in Vercel too.
OPENFURQAN_DATA_KEY=

# Optional maintainer mirror for release rehearsals; SHA-256 pins still apply.
OPENFURQAN_DATA_MIRROR=

# Maintainer-only input directory for build:prayer-locations-supplemental.
GEONAMES_DUMP_DIR=

# Optional service-worker cache version for hosts without a build/commit ID.
NEXT_PUBLIC_APP_VERSION=
# Optional build IDs, checked in this order after NEXT_PUBLIC_APP_VERSION.
# Vercel/GitHub normally supply these automatically; leave blank locally.
VERCEL_GIT_COMMIT_SHA=
VERCEL_DEPLOYMENT_ID=
GITHUB_SHA=
SOURCE_VERSION=
# NODE_ENV is managed by Next.js; do not set it here.
