{
  "name": "openfurqan-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "npm run data:prepare",
    "dev": "next dev",
    "prebuild": "npm run data:prepare",
    "build": "next build",
    "postbuild": "node scripts/check-data-traces.mjs",
    "start": "next start",
    "lint": "eslint .",
    "check:themes": "node scripts/check-theme-tokens.mjs",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "data:prepare": "node scripts/prepare-data.mjs",
    "data:update": "node scripts/prepare-data.mjs --update-lock",
    "verify:prayer": "node scripts/verify-prayer-times.mjs",
    "build:prayer-locations-supplemental": "node scripts/build-prayer-locations-supplemental.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "adhan": "^4.4.6",
    "framer-motion": "^12.43.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  },
  "description": "A Quran reader and study app with recitation, tafsir, word meanings and memorization.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenFurqanOrg/openfurqan-web.git"
  },
  "homepage": "https://openfurqan.com"
}
